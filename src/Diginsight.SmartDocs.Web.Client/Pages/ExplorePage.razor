@page "/"
@page "/explore"
@using System.Globalization
@using Diginsight.SmartDocs.Web.Shared.Sites
@inject INavProvider Provider
@inject PreferencesState Prefs
@inject NavStats Stats
@inject LibraryQueryState Query
@inject SiteShellState Site
@implements IDisposable

<PageTitle>@Site.Title</PageTitle>

<div class="explore">
    <section class="hero">
        <p class="hero-eyebrow">Learning Hub</p>
        <h1>Everything you have <em>learned</em>, in one place.</h1>
        <p>
            Browse the whole library by section, recency or author — then keep what matters with
            favourites, pins and a look that is yours.
        </p>
        <div class="hero-stats">
            <div class="hero-stat">
                <b>@_visible.Count.ToString("N0")</b>
                <span>Articles</span>
            </div>
            <div class="hero-stat">
                <b>@_sections.Count.ToString("N0")</b>
                <span>Sections</span>
            </div>
            <div class="hero-stat">
                <b>@_authorCount.ToString("N0")</b>
                <span>Authors</span>
            </div>
            <div class="hero-stat">
                <b>@(_latest?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "—")</b>
                <span>Last update</span>
            </div>
        </div>
    </section>

    @if (_loading)
    {
        <p class="empty">Loading the library…</p>
    }
    else
    {
        <div class="filterbar">
            <button class="chip @(_section is null ? "is-on" : null)" @onclick="() => SetSection(null)">
                All <b>@_visible.Count</b>
            </button>
            @foreach ((string name, int count) in _sections)
            {
                <button class="chip @(_section == name ? "is-on" : null)" @onclick="() => SetSection(name)">
                    <i class="bi bi-@NavRules.IconFor(name, name)"></i> @name <b>@count</b>
                </button>
            }
            @if (_hiddenSections > 0)
            {
                <button class="chip is-muted"
                        title="Sections you hid in preferences are left out of Explore — click to bring them back"
                        @onclick="() => Prefs.ClearHidden()">
                    <i class="bi bi-eye-slash"></i> @_hiddenSections hidden
                </button>
            }

            <span class="filterbar-sep"></span>

            <select class="filter-select" value="@_recency" @onchange="OnRecencyChanged">
                <option value="any">Any time</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
                <option value="365">Last year</option>
            </select>

            <select class="filter-select" value="@_author" @onchange="OnAuthorChanged">
                <option value="">Any author</option>
                @foreach (string a in _authors)
                {
                    <option value="@a">@a</option>
                }
            </select>

            <select class="filter-select" value="@_sort" @onchange="OnSortChanged">
                <option value="recent">Newest first</option>
                <option value="oldest">Oldest first</option>
                <option value="title">Title A → Z</option>
                <option value="section">By section</option>
            </select>

            <button class="chip @(_favOnly ? "is-on" : null)" @onclick="() => Set(() => _favOnly = !_favOnly)">
                <i class="bi bi-star-fill"></i> Favourites <b>@Prefs.Favourites.Count</b>
            </button>

            <button class="chip @(Prefs.DatedOnly ? "is-on" : null)"
                    title="Only show articles that carry a publication date"
                    @onclick="() => Prefs.SetDatedOnly(!Prefs.DatedOnly)">
                <i class="bi bi-calendar3"></i> Dated only
            </button>

            <span class="spacer"></span>

            <span class="filter-count">@Results.Count.ToString("N0") shown</span>
        </div>

        @if (Query.HasQuery)
        {
            <p class="results-for">
                Results for <strong>“@Query.Query”</strong>
                <span class="filter-count">@Results.Count.ToString("N0") of @_visible.Count.ToString("N0")</span>
            </p>
        }

        @if (Results.Count == 0)
        {
            <p class="empty">
                Nothing matches these filters.
                <button class="link-btn" @onclick="ResetFilters">Reset them</button>
            </p>
        }
        else if (Query.View == LibraryView.Timeline)
        {
            <div class="timeline">
                @foreach (IGrouping<string, NavLeaf> month in Results.Take(_take).GroupBy(MonthKey))
                {
                    <div class="tl-month">@month.Key</div>
                    @foreach (NavLeaf a in month)
                    {
                        <a class="tl-item" href="@a.Route">
                            <span class="tl-date">@(a.Date?.ToString("dd MMM", CultureInfo.InvariantCulture) ?? "—")</span>
                            <span class="tl-title">@Highlight(a.Text)</span>
                            <span class="tl-sec">@SectionOf(a)</span>
                        </a>
                    }
                }
            </div>
        }
        else
        {
            <div class="cards">
                @foreach (NavLeaf a in Results.Take(_take))
                {
                    <a class="card" href="@a.Route">
                        <span class="card-sec">
                            <i class="bi bi-@NavRules.IconFor(SectionOf(a), SectionOf(a))"></i> @SectionOf(a)
                        </span>
                        <h3>@Highlight(a.Text)</h3>
                        <span class="card-path">@a.Path</span>
                        <span class="card-meta">
                            <span>@(a.Date?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "Undated")</span>
                            @if (!string.IsNullOrEmpty(a.Author))
                            {
                                <span>· @a.Author</span>
                            }
                        </span>
                        <button class="fav @(Prefs.IsFavourite(a.Route) ? "is-on" : null)"
                                title="@(Prefs.IsFavourite(a.Route) ? "Remove from favourites" : "Add to favourites")"
                                @onclick:preventDefault="true" @onclick:stopPropagation="true"
                                @onclick="() => Prefs.ToggleFavourite(a.Route)">
                            <i class="bi @(Prefs.IsFavourite(a.Route) ? "bi-star-fill" : "bi-star")"></i>
                        </button>
                    </a>
                }
            </div>
        }

        @if (Results.Count > _take)
        {
            <button class="load-more" @onclick="() => _take += PageSize">
                Show @Math.Min(PageSize, Results.Count - _take) more
            </button>
        }
    }
</div>

@code {
    private const int PageSize = 48;

    private IReadOnlyList<NavLeaf> _all = [];
    private List<NavLeaf> _visible = [];
    private List<(string Name, int Count)> _sections = [];
    private List<string> _authors = [];
    private int _authorCount;
    private int _hiddenSections;
    private DateTimeOffset? _latest;
    private bool _loading = true;

    private string? _section;
    private string _recency = "any";
    private string _author = string.Empty;
    private string _sort = "recent";
    private bool _favOnly;
    private int _take = PageSize;

    // Recomputed per render rather than cached: the filter inputs are a handful of fields over a
    // list of ~1k items, which is far cheaper than the invalidation bookkeeping a cache would need.
    private List<NavLeaf> Results
    {
        get
        {
            IEnumerable<NavLeaf> q = _visible;

            string[] tokens = NavOrdering.Tokenize(Query.Query);
            if (tokens.Length > 0)
            {
                q = q.Where(a => NavOrdering.Matches(a, tokens));
            }

            if (_section is not null)
            {
                q = q.Where(a => SectionOf(a) == _section);
            }

            if (!string.IsNullOrEmpty(_author))
            {
                q = q.Where(a => a.Author == _author);
            }

            if (_favOnly)
            {
                q = q.Where(a => Prefs.IsFavourite(a.Route));
            }

            // "Dated only" and a recency window both require a date; the window additionally bounds it.
            if (Prefs.DatedOnly || Query.View == LibraryView.Timeline)
            {
                q = q.Where(a => a.Date is not null);
            }

            if (int.TryParse(_recency, out int days))
            {
                DateTimeOffset cutoff = DateTimeOffset.UtcNow.AddDays(-days);
                q = q.Where(a => a.Date is { } d && d >= cutoff);
            }

            return _sort switch
            {
                // Undated articles sort last in both directions: an absent date is unknown, not old.
                "oldest" => q.OrderBy(a => a.Date is null).ThenBy(a => a.Date).ToList(),
                "title" => q.OrderBy(a => a.Text, StringComparer.OrdinalIgnoreCase).ToList(),
                "section" => q.OrderBy(SectionOf, StringComparer.OrdinalIgnoreCase)
                              .ThenBy(a => a.Text, StringComparer.OrdinalIgnoreCase).ToList(),
                _ => q.OrderBy(a => a.Date is null).ThenByDescending(a => a.Date).ToList(),
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Prefs.Changed += OnPrefsChanged;
        Query.Changed += OnQueryChanged;

        _all = await Provider.GetIndexAsync();
        Rebuild();
        _loading = false;
    }

    // A section hidden in preferences is hidden here too — it leaves the chips, the results and the
    // counts — so Explore never offers a filter the rest of the app has been told to forget. The
    // derived lists are rebuilt on that gesture rather than filtered again on every render.
    private void Rebuild()
    {
        _visible = _all.Where(a => !Prefs.IsHidden(SectionOf(a))).ToList();

        _sections = _visible.GroupBy(SectionOf)
                            .Select(g => (g.Key, g.Count()))
                            .OrderByDescending(t => t.Item2)
                            .ToList();

        _hiddenSections = _all.Select(SectionOf)
                              .Distinct(StringComparer.OrdinalIgnoreCase)
                              .Count(Prefs.IsHidden);

        _authors = _visible.Select(a => a.Author)
                           .Where(a => !string.IsNullOrWhiteSpace(a))
                           .Select(a => a!)
                           .Distinct(StringComparer.OrdinalIgnoreCase)
                           .OrderBy(a => a, StringComparer.OrdinalIgnoreCase)
                           .ToList();

        _authorCount = _authors.Count;
        _latest = _visible.Count == 0 ? null : _visible.Max(a => a.Date);

        // A filter left pointing at something that is now hidden would empty the page with no way
        // to tell why, so it is dropped rather than kept.
        if (_section is not null && !_sections.Any(s => s.Name == _section))
        {
            _section = null;
            _take = PageSize;
        }

        if (!string.IsNullOrEmpty(_author) && !_authors.Contains(_author, StringComparer.OrdinalIgnoreCase))
        {
            _author = string.Empty;
            _take = PageSize;
        }
    }

    // The breadcrumb's first segment is the top-level section; a leaf sitting at the root has none.
    private static string SectionOf(NavLeaf a)
    {
        if (string.IsNullOrEmpty(a.Path))
        {
            return "Root";
        }

        int i = a.Path.IndexOf('\u203a');
        return (i < 0 ? a.Path : a.Path[..i]).Trim();
    }

    private static string MonthKey(NavLeaf a) =>
        a.Date?.ToString("MMMM yyyy", CultureInfo.InvariantCulture) ?? "Undated";

    // Any filter change invalidates the current page window; otherwise "show more" would carry over
    // into a narrower result set and reveal the whole thing at once.
    private void Set(Action change)
    {
        change();
        _take = PageSize;
    }

    private void OnRecencyChanged(ChangeEventArgs e) => Set(() => _recency = e.Value?.ToString() ?? "any");

    private void OnAuthorChanged(ChangeEventArgs e) => Set(() => _author = e.Value?.ToString() ?? string.Empty);

    private void OnSortChanged(ChangeEventArgs e) => Set(() => _sort = e.Value?.ToString() ?? "recent");

    private void SetSection(string? name) => Set(() => _section = _section == name ? null : name);

    private void ResetFilters() => Set(() =>
    {
        _section = null;
        _recency = "any";
        _author = string.Empty;
        _favOnly = false;
    });

    private void OnPrefsChanged() => InvokeAsync(() =>
    {
        Rebuild();
        StateHasChanged();
    });

    // A new query or view means the current page window no longer describes what is on screen.
    private void OnQueryChanged()
    {
        _take = PageSize;
        InvokeAsync(StateHasChanged);
    }

    // Wraps every matched token so readers can see why an article came back. Built as a render
    // fragment rather than raw HTML so the article title is never interpreted as markup.
    private RenderFragment Highlight(string text) => builder =>
    {
        string[] tokens = NavOrdering.Tokenize(Query.Query);
        if (tokens.Length == 0)
        {
            builder.AddContent(0, text);
            return;
        }

        int at = 0;
        int seq = 0;
        foreach ((int start, int length) in NavOrdering.HighlightRanges(text, tokens))
        {
            if (start > at)
            {
                builder.AddContent(seq++, text[at..start]);
            }

            builder.OpenElement(seq++, "mark");
            builder.AddContent(seq++, text.Substring(start, length));
            builder.CloseElement();
            at = start + length;
        }

        if (at < text.Length)
        {
            builder.AddContent(seq, text[at..]);
        }
    };

    public void Dispose()
    {
        Prefs.Changed -= OnPrefsChanged;
        Query.Changed -= OnQueryChanged;
    }
}
