@inherits LayoutComponentBase
@implements IDisposable
@using Diginsight.SmartDocs.Web.Shared.Navigation
@using Diginsight.SmartDocs.Web.Shared.Sites
@inject IJSRuntime JS
@inject ThemeState Theme
@inject SidebarState Sidebar
@inject NavStats Stats
@inject ArticleState Article
@inject SiteShellState Site
@inject PreferencesState Prefs
@inject LibraryQueryState Query
@inject NavigationManager NavMgr
@inject HttpClient Http

<div class="page theme-@Theme.ThemeId" data-density="@Prefs.Density" data-font="@Prefs.Font">
    <div class="ambient" aria-hidden="true"><span></span><span></span><span></span></div>

    <header class="topbar">
        <a class="brand" href=""><i class="bi @BrandIconClass"></i> <span>@Site.Title</span></a>

        <div class="topsearch">
            <i class="bi bi-search"></i>
            <input type="search" placeholder="@SearchPlaceholder" aria-label="Search the library"
                   value="@Query.Query" @oninput="OnSearchInput" @onkeydown="OnSearchKeyDown" />
            <kbd>/</kbd>
        </div>

        <div class="viewseg">
            <button class="@(IsExploring && Query.View == LibraryView.Cards ? "is-on" : null)"
                    @onclick="() => GoToLibrary(LibraryView.Cards)">Explore</button>
            <button class="@(IsExploring && Query.View == LibraryView.Timeline ? "is-on" : null)"
                    @onclick="() => GoToLibrary(LibraryView.Timeline)">Timeline</button>
        </div>

        <AboutMenu />
        <button class="icon-btn" title="Notifications" @onclick="() => _notifyOpen = !_notifyOpen">
            <i class="bi bi-bell"></i>
        </button>
        <button class="icon-btn" title="Reading preferences" @onclick="() => _prefsOpen = true">
            <i class="bi bi-sliders"></i>
        </button>
        <button class="theme-btn" title="Toggle light/dark" @onclick="() => Theme.Toggle()">
            @(Theme.Dark ? "☀️" : "🌙")
        </button>
    </header>

    <NotificationPanel Open="_notifyOpen" OnClose="() => _notifyOpen = false" />
    <PreferencesDrawer Open="_prefsOpen" OnClose="() => _prefsOpen = false" />

    <div class="body">
        <nav class="sidebar @(Sidebar.Collapsed ? "rail" : null)">
            <DynNav />
        </nav>
        <div class="sidebar-resizer" title="Drag to resize · double-click to reset"></div>
        <main class="content">
            @Body
        </main>
        <TocPane />
    </div>

    <footer class="bottombar">
        <span class="bottombar-left">@SectionLine<br />Total: @TotalArticlesText</span>
        <span class="bottombar-right">@ArticleLine<br />@ArticleMetaLine</span>
    </footer>
</div>

