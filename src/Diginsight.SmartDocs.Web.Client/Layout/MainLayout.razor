@inherits LayoutComponentBase
@implements IDisposable
@using Diginsight.SmartDocs.Web.Shared.Navigation
@using Diginsight.SmartDocs.Web.Shared.Sites
@inject IJSRuntime JS
@inject ThemeState Theme
@inject SidebarState Sidebar
@inject NavStats Stats
@inject ArticleState Article
@inject SiteShellState Site
@inject HttpClient Http

<div class="page theme-@Theme.ThemeId">
    <header class="topbar">
        <a class="brand" href="">
            @if (Site.HasLogo)
            {
                <img class="brand-logo" src="@Site.LogoUrl" alt="" />
            }
            else
            {
                <i class="bi @BrandIconClass"></i>
            }
            <span>@Site.Title</span>
        </a>
        <SpaceSwitcher />
        <div class="topbar-spacer"></div>
        <AboutMenu />
        <button class="topbar-search" type="button" title="Search" @onclick="() => _searchOpen = true">
            <i class="bi bi-search"></i>
            <span class="topbar-search-label">Search</span>
        </button>
        <button class="icon-btn" title="Notifications" @onclick="() => _notifyOpen = !_notifyOpen">
            <i class="bi bi-bell"></i>
        </button>
        <button class="theme-btn" title="Toggle light/dark" @onclick="() => Theme.Toggle()">
            @(Theme.Dark ? "☀️" : "🌙")
        </button>
    </header>

    <nav class="tabbar">
        <TopMenu Placement="TopMenu.Group.Left" />
        <TopMenu Placement="TopMenu.Group.Right" />
    </nav>

    <SearchOverlay Open="_searchOpen" OnClose="() => _searchOpen = false" />
    <NotificationPanel Open="_notifyOpen" OnClose="() => _notifyOpen = false" />

    <div class="body">
        <nav class="sidebar @(Sidebar.Collapsed ? "rail" : null)">
            <DynNav />
        </nav>
        <div class="sidebar-resizer" title="Drag to resize · double-click to reset"></div>
        <main class="content">
            @Body
        </main>
        <TocPane />
    </div>

    <footer class="bottombar">
        <span class="bottombar-left">@SectionLine<br />Total: @TotalArticlesText</span>
        <span class="bottombar-right">@ArticleLine<br />@ArticleMetaLine</span>
    </footer>
</div>

