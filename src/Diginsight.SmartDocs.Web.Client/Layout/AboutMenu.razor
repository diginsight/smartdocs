@inject ThemeState Theme
@implements IDisposable

<div class="topmenu">
    <div class="topmenu-item">
        <button class="topmenu-btn" type="button">
            <i class="bi bi-info-circle"></i>
            <span>About</span>
            <span class="caret">▾</span>
        </button>
        <div class="topmenu-dropdown">
            <ul class="dropdown-list">
                <li><a class="dropdown-link" href="readme">About</a></li>
                <li><a class="dropdown-link" href="_content-raw/LICENSE" target="_blank" rel="noopener">License</a></li>
                <li class="dropdown-sep">
                    <hr />
                </li>

                <li><span class="dropdown-subhead">Light themes</span></li>
                @foreach (ThemeOption opt in ThemeState.Options.Where(o => !o.Dark))
                {
                    <li>@ThemeItem(opt)</li>
                }

                <li><span class="dropdown-subhead">Dark themes</span></li>
                @foreach (ThemeOption opt in ThemeState.Options.Where(o => o.Dark))
                {
                    <li>@ThemeItem(opt)</li>
                }

                <li class="dropdown-sep">
                    <hr />
                </li>
                <li>
                    <button class="dropdown-action" type="button" @onclick="() => Theme.Reset()">
                        <span class="theme-swatch" style="visibility:hidden"></span>Reset theme
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>

