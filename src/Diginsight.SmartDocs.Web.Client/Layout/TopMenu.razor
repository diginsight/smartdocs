@inject INavProvider NavProvider

@if (_root is not null)
{
    <nav class="topmenu @(Placement == Group.Right ? "topmenu-right" : "topmenu-left")">
        @foreach (NavChild node in DisplayNodes())
        {
            @if (node.IsSection)
            {
                <div class="topmenu-item @(IsOpen(node) ? "open" : null)">
                    <button class="topmenu-btn" type="button" @onclick="() => ToggleAsync(node)">
                        @if (!string.IsNullOrEmpty(node.Icon))
                        {
                            <i class="bi bi-@node.Icon"></i>
                        }
                        <span>@ShortFor(node)</span>
                        <span class="caret">▾</span>
                    </button>
                    @if (node.Prefix is not null && _children.TryGetValue(node.Prefix, out IReadOnlyList<NavChild>? kids) &&
        kids.Count > 0)
                    {
                        <div class="topmenu-dropdown">
                            <TopMenuDropdown Nodes="kids" />
                        </div>
                    }
                </div>
            }
            else if (node.Route is not null)
            {
                <a class="topmenu-link" href="@node.Route">
                    @if (!string.IsNullOrEmpty(node.Icon))
                    {
                        <i class="bi bi-@node.Icon"></i>
                    }
                    <span>@ShortFor(node)</span>
                </a>
            }
        }
    </nav>
}

