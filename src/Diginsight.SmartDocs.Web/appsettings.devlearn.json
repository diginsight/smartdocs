{
  // Local filesystem profile: public Learn at /learn; role-gated internal Learn at /learn-internal.
  // With no root-mounted space, "/" serves the reader-filtered space index.
  // Explicit DefaultTheme values keep reader theme choices separate for the two spaces.
  // The internal root's metadata.yml:access maps Reader to Read, and Contributor/Admin to Read+Write.
  // Legacy access.metadata.yml is accepted while compatibility is enabled.
  // AccessFileRequired keeps that space hidden if its logical policy is missing or invalid.
  // AzureAd identifiers and the internal FileSystem:RootPath come from the private overlay at
  // smartdocs.internal\src\Diginsight.SmartDocs.Web\appsettings.devlearn.json, loaded through the
  // launch profile's ExternalConfigurationFolder, with filesystem roots in appsettings.devlearn.local.json.
  // The external environment file declares official Blob sources; its local sibling selects FileSystem.
  "Site": {
    "Title": "Learning Hub",
    "Branding": {
      "ProductName": "Learning Hub",
      "IconClass": "bi-lightbulb-fill",
      "DefaultTheme": "cosmo"
    },
    "Spaces": [
      {
        "Id": "learn",
        "RouteBase": "/learn",
        "Title": "Learning Hub",
        "DefaultTheme": "cosmo",
        "Icon": "\uD83D\uDCA1",
        "RepositoryUrl": "https://github.com/darioairoldi/Learn",
        "AllowGptBot": true,
        "Source": "FileSystem",
        "FileSystem": {
          "RootPath": "..\\..\\..\\..\\darioairoldi\\Learn.01",
          "WatchForChanges": true
        }
      },
      {
        "Id": "learn-internal",
        "RouteBase": "/learn-internal",
        "Title": "Learning Hub (internal)",
        "DefaultTheme": "sandstone",
        "Icon": "\uD83D\uDD12",
        "AllowGptBot": false,
        "Access": "authenticated",
        "AccessFileRequired": true,
        "Source": "FileSystem",
        "FileSystem": {
          "WatchForChanges": true
        }
      }
    ]
  },
  //"Logging": {
  //  "LogLevel": {
  //    "Default": "Information",
  //    "Microsoft.AspNetCore": "Warning",
  //    "Diginsight": "Debug",
  //    "Diginsight.*": "Debug",
  //    "Diginsight.SmartDocs.Web": "Trace"
  //  }
  //},
  // DebugEnabled routes every log record through System.Diagnostics.Debug. On macOS and Linux that
  // write costs roughly 38ms, paid synchronously inside the request: at the Trace level above, a
  // single /_nav call emits enough records to take 4-5 seconds, and browsing feels broken. The same
  // records still reach the log4net file, so nothing is lost by leaving this off. Measured on the
  // Learning Hub content set: /_nav 4.9s with it on, 0.034s with it off.
  "Observability": {
    "ConsoleEnabled": false,
    "Log4NetEnabled": true,
    "DebugEnabled": false
  }
}