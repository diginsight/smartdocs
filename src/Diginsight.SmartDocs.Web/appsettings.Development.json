{
  // Local runs read the repository clone directly, so an edit is live on the next request.
  "Site": {
    "Spaces": [
      {
        "Id": "diginsight.smartdocs",
        "RouteBase": "/",
        "Title": "SmartDocs",
        "Source": "FileSystem",
        "FileSystem": {
          "RootPath": "..\\docs",
          "WatchForChanges": true
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Diginsight": "Debug",
      "Diginsight.*": "Debug",
      "Diginsight.SmartDocs.Web": "Trace"
    }
  },
  "Observability": {
    "ConsoleEnabled": false,
    "Log4NetEnabled": true,
    "DebugEnabled": true
  }
}