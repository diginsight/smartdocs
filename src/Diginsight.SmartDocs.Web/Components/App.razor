@using Diginsight.SmartDocs.Web.Shared
@using Diginsight.SmartDocs.Web.Shared.Sites
@using Microsoft.Extensions.Options
@inject IOptions<SiteOptions> Site
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Every URL below is rooted: a crawler that ignores <base> resolves a relative one against the
       page's own URL and invents a nested route for it. The icon is declared so browsers never fall
       back to /favicon.ico. *@
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/app.css" />
    @* This deployment's palettes, written out by the host rather than shipped in app.css. Emitted
       during prerender and after app.css, so the selected theme is painted on the first frame —
       applying it from the client would show the default palette until hydration. *@
    <style>@((MarkupString)ThemeCatalog.ToCss(ThemeCatalog.Resolve(Site.Value.Themes)))</style>
    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    <Routes @rendermode="InteractiveWebAssembly" />
    <script src="/js/app-ui.js"></script>
    <script src="/_framework/blazor.web.js"></script>
</body>

</html>
