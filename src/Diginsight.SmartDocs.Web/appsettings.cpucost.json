{
  // Instrumentation-cost overlay. Selected with AppsettingsEnvironmentName=cpucost, it serves this
  // repository's own documentation with the logging and observability profile a deployed instance
  // runs, so the cost of instrumentation can be measured where the machine is controlled.
  //
  // It exists because the same comparison on a deployed App Service instance could not separate
  // request cost from background cost: on a shared B1 core the startup walk was still burning
  // 45-51 CPU-seconds per minute during a window that served three requests.
  //
  // The levels below restate the base file's rather than inheriting them, so that a run against
  // this overlay is unaffected by the Development overlay's debug levels.
  "Site": {
    "Spaces": [
      {
        "Id": "diginsight.smartdocs",
        "RouteBase": "/",
        "Title": "SmartDocs",
        "Icon": "\uD83D\uDCD8",
        "Source": "FileSystem",
        "FileSystem": {
          // No watcher: a file watcher over the content set is itself work under measurement.
          "RootPath": "..\\docs",
          "WatchForChanges": false
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Diginsight": "Warning",
      "Diginsight.*": "Warning",
      // Mirrors the base settings, including C9's Warning. A run that wants the pre-wave-0 profile
      // overrides this to Information and switches the HotPath source on, so before and after can be
      // measured in one session on one machine.
      "Diginsight.SmartDocs.Web": "Warning"
    }
  },
  // Log4Net on, as deployed. Console off: a deployed instance writes to the platform's pipeline,
  // and a local console window would charge this process for rendering the text.
  "Observability": {
    "ConsoleEnabled": false,
    "Log4NetEnabled": true,
    "DebugEnabled": false
  }
}
