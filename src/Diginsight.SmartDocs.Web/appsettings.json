{
  "AllowedHosts": "*",
  "AzureKeyVault": {
    "Uri": ""
  },
  "Site": {
    "Title": "Diginsight SmartDocs",
    "NotFoundPath": "404.html",
    "InvalidateApiKey": "",
    "Branding": {
      "ProductName": "Diginsight SmartDocs",
      "IconClass": "bi-lightbulb-fill",
      "LogoPath": ""
    },
    // Site:Spaces is declared ONLY by the environment overlay, never here. Configuration binds a
    // JSON array by index (Site:Spaces:0:Id, ...), so an overlay patches an element rather than
    // replacing it: any field left here would silently leak into every environment. Each overlay
    // therefore states its space element in full, and a missing declaration fails loudly at
    // startup ("Site:Spaces is empty") instead of booting the wrong content set.
    //
    // Where a space is mounted is stated by its RouteBase and by nothing else. At most one space
    // may claim "/"; every other space reserves the first segment of its route base.
    // Storage identity (AccountUri, ContainerName) is environment-specific and deliberately absent
    // from this public repository — it arrives from the external configuration overlay.
    "Spaces": []
  },
  "Diginsight": {
    "Activities": {
      "ActivitySources": {
        "Diginsight.*": true,
        "Experimental.*": false,
        "Diginsight.SmartDocs.Web": true,
        "Microsoft.AspNetCore": true,
        "System.Net.Http": true
      },
      "LogBehavior": "Show",
      "LoggedActivityNames": {
        "Microsoft.AspNetCore.Hosting.HttpRequestIn": "Hide",
        "System.Net.Http|System.Net.Http.HttpRequestOut": "Hide"
      },
      "LogLevel": "Debug",
      "EnablePayloadLogging": true,
      "SpanDurationMeterName": "Diginsight.SmartDocs.Web",
      "MetricSpecificSpanMeasuredActivityNames": [
        {
          "ActivityNames": {},
          "MetricName": "diginsight.span_duration"
        },
        {
          "ActivityNames": {},
          "MetricName": "diginsight.query_cost"
        }
      ],
      "MetricSpecificTags": [
        {
          "MetricName": "diginsight.span_duration",
          "MetricTags": []
        },
        {
          "MetricName": "diginsight.query_cost",
          "MetricTags": []
        }
      ],
      "MetricTags": [
        "category_name",
        "device_type",
        "plant_company",
        "plant_id",
        "plant_name",
        "plant_type",
        "user_company",
        "widget_template"
      ],
      "RecordSpanDuration": true,
      "SpanMeasuredActivityNames": {
        "*Controller*": true,
        "*CosmosDbObservableExtensions*": true,
        "*ObservableFeedIterator*": true,
        "ObservableTransactionalBatch": true
      }
    },
    "Components": {
      // IParallelService tiers (bounded ParallelOptions.MaxDegreeOfParallelism):
      // Low = heavy/expensive/fragile per-item work (protect scarce downstream capacity),
      // Medium = ordinary, non-heavy I/O (the everyday default),
      // High = cheap/fast, low-footprint work against a robust downstream.
      "LowConcurrency": 2,
      "MediumConcurrency": 8,
      "HighConcurrency": 16
    },
    "SmartCache": {
      "AbsoluteExpiration": "31.00:00:00",
      "Enabled": false,
      "MaxAge": "7.00:00:00",
      "Redis": {
        // Set "Configuration" (e.g. "localhost:6379") to enable the Redis passive backing store.
        "Configuration": "",
        "KeyPrefix": "smartdocs-content:"
      },
      "ServiceBus": {
        // "ConnectionString" from Key Vault; with a TopicName it enables the Service Bus companion.
        "TopicName": "smartcache-learnweb"
      },
      "SlidingExpiration": "7.00:00:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Diginsight.SmartCache.Externalization.ServiceBus": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Observability": {
    "ConsoleEnabled": true,
    "DebugEnabled": false,
    "Log4NetEnabled": true
  },
  "OpenTelemetry": {
    "ActivitySources": [
      "Diginsight.*",
      "Diginsight.SmartDocs.Web",
      "Microsoft.AspNetCore"
    ],
    "AzureMonitorConnectionString": "",
    "EnableMetrics": true,
    "EnableTraces": true,
    "ExcludedHttpHosts": [
      ".applicationinsights.azure.com",
      ".monitor.azure.com"
    ],
    "Meters": [
      "Diginsight.SmartDocs.Web"
    ]
  }
}