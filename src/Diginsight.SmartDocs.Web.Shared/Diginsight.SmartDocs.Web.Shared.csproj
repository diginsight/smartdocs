<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Diginsight.SmartDocs.Web.Shared</RootNamespace>
    <AssemblyName>Diginsight.SmartDocs.Web.Shared</AssemblyName>
    <!-- The host's deploy runtimes, from Diginsight.SmartDocs.Web.csproj. A self-contained publish of
         the host restores this library for the same runtime, so its lock file must carry those targets
         too. The build output stays runtime-neutral, for the server and the WebAssembly client alike. -->
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Component base types; works in both the server (prerender) and the WASM client. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" />
    <!-- Pure managed Markdown engine: runs in-process on the server AND inside WASM. -->
    <PackageReference Include="Markdig" Version="0.*" />
  </ItemGroup>

</Project>
