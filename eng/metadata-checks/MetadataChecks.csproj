<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Diginsight.SmartDocs.Web\Diginsight.SmartDocs.Web.csproj" />
    <ProjectReference Include="..\sample-role-provider\SampleRoleProvider.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopySampleProvider" AfterTargets="Build">
    <MSBuild Projects="..\sample-role-provider\SampleRoleProvider.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="SampleProviderTarget" />
    </MSBuild>
    <ItemGroup>
      <SampleProviderFiles Include="%(SampleProviderTarget.RootDir)%(SampleProviderTarget.Directory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SampleProviderFiles)"
          DestinationFiles="@(SampleProviderFiles->'$(OutDir)plugins\sample\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
