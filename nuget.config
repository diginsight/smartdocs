<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repository-scoped NuGet configuration.

    <clear /> discards any package sources inherited from machine or user level
    configs, so a private feed configured on a build agent cannot make restore
    fail with NU1301: 401 (Unauthorized).

    Every dependency of this repository (including Diginsight.Core /
    Diginsight.Diagnostics / Diginsight.SmartCache / Diginsight.Components*) is
    published to public nuget.org, so nuget.org is the only source needed. The
    www.nuget.org endpoint is used because api.nuget.org fails TLS negotiation on
    the Windows development environment. This keeps restore deterministic and
    credential-free both locally and in CI.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://www.nuget.org/api/v2/" protocolVersion="2" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
